{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "C:\\Program Files\\LLVM\\bin\\clang.exe",
            "args": [
                "-g",
                "-O0",
                "-Wall",
                "-Wextra",
                "-std=gnu17",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "C/C++: clang build active file（-g 生成调试符号，-O0 关闭优化，-Wall -Wextra 开启常用告警，-std=gnu17）"
        }
    ]
}